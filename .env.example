MN_EMAIL=your@email.com
MN_PASSWORD=yourpassword

# Optional: persist browser profile/cookies across runs (helps avoid repeated challenges).
# The server auto-wipes this directory if MN_EMAIL changes since the last
# successful login, so you don't get silently signed in as the previous account.
# PUPPETEER_USER_DATA_DIR=.puppeteer-profile

# Port for the Express server (default: 3000)
# PORT=3000

# Set to "debug" for verbose Puppeteer diagnostics
# REMOVE_MEMBERS_LOG_LEVEL=light

# ---------------------------------------------------------------------------
# Failure diagnostics (Puppeteer screenshot + metadata dump)
# ---------------------------------------------------------------------------
# When an add-space-member task fails, the server writes a PNG screenshot
# and a JSON metadata file (URL, title, body class, error) to this dir so
# the operator can see what page MN/Cloudflare was actually serving at
# the moment of failure. Defaults to ./data/diagnostics under the working
# directory; that path is already gitignored. Files are named
# "<UTC timestamp>-<reason>-<memberId>-<space slug>.{png,json}" so they
# pair up and sort chronologically. There's no automatic rotation — clean
# the dir periodically if you don't want it to grow.
# DIAG_DUMP_DIR=./data/diagnostics

# ---------------------------------------------------------------------------
# Admin-email-on-run (production only)
# ---------------------------------------------------------------------------
# The server emails an end-of-run log to hard-coded admin addresses (see
# src/email.ts ADMIN_EMAILS) only when NODE_ENV === "production" AND every
# required SMTP_* var below is set. Otherwise it silently no-ops.

# NODE_ENV=production

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp-username
# SMTP_PASS=smtp-password
# SMTP_FROM="MN Host Automator <bot@example.com>"

# ---------------------------------------------------------------------------
# Agreements Watcher (Stage 4a)
# ---------------------------------------------------------------------------
# The IMAP poller watches a mailbox for MN per-comment notifications. When
# a member posts "I agree" on the agreement article the server auto-
# enqueues the "add-to-all-spaces" flow for them. The poller is OPT-IN:
# it starts only when (IMAP_USER or MN_EMAIL), IMAP_HOST, and IMAP_PASSWORD
# are all set.
#
# IMAP_USER: the full email address that IMAP authenticates as. Defaults
#   to MN_EMAIL when unset. Set it explicitly whenever MN_EMAIL is a
#   forwarding alias (e.g. host@company.org) and the actual mailbox lives
#   at a different address (e.g. ec-bot@gmail.com). Gmail App Passwords
#   are keyed to the mailbox account, NOT the alias.
#
# Gmail users: create an App Password (https://myaccount.google.com/apppasswords)
# with 2FA on, and use that as IMAP_PASSWORD - Gmail's regular password
# will be rejected over IMAP.

# IMAP_USER=ec-bot@gmail.com
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_PASSWORD=app-password-here
# IMAP_MAILBOX=INBOX

# SQLite DB path for the EC admin store (agreements, future tables).
# Defaults to ./data/ec-admin.db under the working directory.
# EC_ADMIN_DB_PATH=./data/ec-admin.db

# Milliseconds between IMAP inbox checks when the agreements watcher is enabled.
# Default: 300000 (5 minutes).
# IMAP_POLL_INTERVAL_MS=300000

# Optional (Stage 4c): node-cron schedule to re-enqueue "add member to all spaces"
# for anyone already at REQUIRED_AGREEMENT_COUNT in SQLite. Repairs missed or
# partial adds; jobs share the same background queue as IMAP-triggered adds.
# Behavior:
#   - unset / empty:       OFF (opt-in)
#   - any cron expression: run on that schedule
#   - off | disabled |
#     false | no | 0:      explicitly OFF (case-insensitive)
# Example — daily at 02:30 in the server's local timezone:
# RECONCILE_COMMONS_CRON=30 2 * * *

# Stage 4e change-of-heart audit cron (DEFAULT ON).
# This runs the change-of-heart audit on a schedule. Behavior:
#   - unset / empty:       use default schedule "0 3 * * *" (daily 03:00 local)
#   - any cron expression: run on that schedule instead of the default
#   - off | disabled |
#     false | no | 0:      DISABLE the audit (case-insensitive)
# The audit visits every agreement post, expands all comments, and writes
# audit_state for each member's row(s). Anomalies (deleted / edited / mixed)
# stop counting toward the agreement threshold and are emailed to the admin.
# AGREEMENTS_AUDIT_CRON=0 3 * * *

# ---------------------------------------------------------------------------
# Active member list export (collectActiveMemberList)
# ---------------------------------------------------------------------------
# The "Members" tab in the admin UI runs a Puppeteer scrape of the global
# admin members page and writes data/active-members.csv (members with at
# least 1 year of tenure who were active in the past 90 days). The CSV
# contains member PII (full name + member id), so the file lives outside
# the static-served `public/` directory and is downloadable only through
# a token-gated endpoint.
#
# When ACTIVE_MEMBER_LIST_TOKEN is unset, the download endpoints return
# 404 and the UI shows a hint reminding the operator to set this var.
# When it is set, the UI fetches the token on demand (it never appears
# in the static HTML) and uses it to authenticate the download click.
# Pick a long random string — anyone with this token can download the
# CSV from this server.
#
# Generate one quickly with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Optionally override the on-disk path of the generated CSV with
# ACTIVE_MEMBER_LIST_PATH; defaults to ./data/active-members.csv.

# ACTIVE_MEMBER_LIST_TOKEN=replace-me-with-32-bytes-of-hex
# ACTIVE_MEMBER_LIST_PATH=./data/active-members.csv

# Optional: set to "debug" for extra Puppeteer diagnostics during the
# active-member scrape. Defaults to "light".
# COLLECT_MEMBERS_LOG_LEVEL=light
