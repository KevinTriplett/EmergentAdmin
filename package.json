{
  "name": "emergent-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:dist": "rm -rf dist",
    "clean:profile": "rm -rf \"${PUPPETEER_USER_DATA_DIR:-.puppeteer-profile}\"",
    "clean:cache": "rm -rf \"${PUPPETEER_CACHE_DIR:-.cache/puppeteer}\"",
    "clean:all": "npm run clean:dist && npm run clean:profile && npm run clean:cache",
    "build": "npm run clean:dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "install:browsers": "puppeteer browsers install chrome",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.3.2",
    "mailparser": "^3.9.8",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "puppeteer": "^24.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
